---
interface Job {
  company: string;
  role: string;
  start: string;
  end: string;
  highlights: string[];
}

interface Props {
  items: Job[];
  location?: string;
  showAllHighlights?: boolean;
}

const { items, location = 'Pune, India', showAllHighlights = false } = Astro.props;
---

<div class="timeline">
  {items.map((job, index) => {
    const isCurrent = index === 0;
    const highlights = showAllHighlights ? job.highlights : job.highlights.slice(0, 1);
    return (
      <article class={`timeline-item ${isCurrent ? 'current' : ''}`}>
        <div class="timeline-rail" aria-hidden="true">
          <div class="timeline-node"></div>
          {index < items.length - 1 && <div class="timeline-line"></div>}
        </div>
        <div class="timeline-body">
          <header class="timeline-header">
            <div class="role-group">
              <h3 class="role">{job.role}</h3>
              <p class="company">{job.company} · {location}</p>
            </div>
            <span class="period mono">{job.start} — {job.end}</span>
          </header>
          <ul class="highlights">
            {highlights.map((highlight) => (
              <li>{highlight}</li>
            ))}
          </ul>
        </div>
      </article>
    );
  })}
</div>

<style>
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    margin-top: 2rem;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    gap: 1.5rem;
    position: relative;
  }

  .timeline-rail {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .timeline-node {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--muted);
    box-sizing: border-box;
    margin-top: 0.35rem;
    z-index: 2;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .timeline-item.current .timeline-node {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .timeline-item:hover .timeline-node {
    transform: scale(1.15);
    border-color: var(--accent);
  }

  .timeline-line {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: 0.775rem;
    bottom: -0.775rem;
    width: 2px;
    background: var(--line-section);
    z-index: 1;
  }

  .timeline-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }

  .timeline-item:last-child .timeline-body {
    padding-bottom: 0;
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .role-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .role {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0.01em;
    color: var(--ink);
    transition: color 160ms ease;
  }

  .timeline-item:hover .role {
    color: var(--accent);
  }

  .company {
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
  }

  .period {
    font-family: var(--mono);
    font-size: var(--type-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--line-inner);
    border-radius: 2px;
    background: color-mix(in srgb, var(--ink) 3%, transparent);
    white-space: nowrap;
    align-self: flex-start;
  }

  .timeline-item.current .period {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .highlights {
    margin: 0;
    padding-left: 1.25rem;
    max-width: 58rem;
    list-style-type: square;
  }

  .highlights li {
    margin-bottom: 0.75rem;
    line-height: 1.6;
    color: var(--ink);
    text-wrap: pretty;
  }

  .highlights li:last-child {
    margin-bottom: 0;
  }

  .highlights li::marker {
    color: var(--accent);
    font-size: 0.85em;
  }

  @media (max-width: 640px) {
    .timeline-item {
      grid-template-columns: 1.25rem 1fr;
      gap: 1rem;
    }

    .timeline-header {
      flex-direction: column;
      gap: 0.5rem;
    }

    .period {
      align-self: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-node,
    .role {
      transition: none;
    }

    .timeline-item:hover .timeline-node {
      transform: none;
    }
  }
</style>
