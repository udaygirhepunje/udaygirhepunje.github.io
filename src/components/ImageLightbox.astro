---
interface Props {
  src: string;
  alt: string;
  id: string;
}

const { src, alt, id } = Astro.props;
const popoverId = `lightbox-${id}`;
const dialogId = `dialog-${id}`;
---

<div class="lightbox" data-lightbox>
  <button
    class="thumbnail"
    type="button"
    popovertarget={popoverId}
    data-lightbox-open
    aria-label={`Open larger image: ${alt}`}
  >
    <img src={src} alt={alt} loading="lazy" />
  </button>
  <div class="popover" id={popoverId} popover="auto">
    <button type="button" popovertarget={popoverId} popovertargetaction="hide" aria-label="Close image">Close</button>
    <img src={src} alt={alt} />
  </div>
  <dialog id={dialogId}>
    <button type="button" data-dialog-close aria-label="Close image">Close</button>
    <img src={src} alt={alt} />
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((root) => {
    if ('showPopover' in HTMLElement.prototype) return;
    const trigger = root.querySelector<HTMLButtonElement>('[data-lightbox-open]');
    const dialog = root.querySelector<HTMLDialogElement>('dialog');
    trigger?.removeAttribute('popovertarget');
    trigger?.addEventListener('click', () => dialog?.showModal());
    root.querySelector('[data-dialog-close]')?.addEventListener('click', () => dialog?.close());
  });
</script>

<style>
  .thumbnail {
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .thumbnail img {
    width: 100%;
    max-height: 75vh;
    object-fit: cover;
  }

  .popover,
  dialog {
    width: min(94vw, 90rem);
    max-width: none;
    max-height: 94vh;
    padding: 3rem;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
  }

  .popover::backdrop,
  dialog::backdrop {
    background: rgb(0 0 0 / 75%);
  }

  .popover img,
  dialog img {
    width: 100%;
    max-height: calc(94vh - 6rem);
    object-fit: contain;
  }

  .popover > button,
  dialog > button {
    position: absolute;
    z-index: 1;
    top: 0.8rem;
    right: 0.8rem;
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--mono);
    font-size: var(--type-label);
    text-transform: uppercase;
    cursor: pointer;
  }

  @supports (transition-behavior: allow-discrete) {
    .popover {
      opacity: 0;
      transform: scale(0.98);
      transition:
        opacity 160ms,
        transform 160ms,
        overlay 160ms allow-discrete,
        display 160ms allow-discrete;
    }

    .popover:popover-open {
      opacity: 1;
      transform: scale(1);
    }

    @starting-style {
      .popover:popover-open {
        opacity: 0;
        transform: scale(0.98);
      }
    }
  }
</style>
