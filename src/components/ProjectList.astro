---
export interface Project {
  slug: string;
  title: string;
  summary: string;
  outcome?: string;
  tech: string[];
  role?: string;
  duration?: string;
  cover?: string;
  stars?: number;
}

interface Props {
  projects: Project[];
  limit?: number;
}

const { projects, limit } = Astro.props;
const visible = typeof limit === 'number' ? projects.slice(0, limit) : projects;
---

<div class="project-grid">
  {visible.map((project, index) => (
    <article class="project-card" style={`--i:${index}`}>
      <a href={`/projects/${project.slug}/`} class="card-link">
        <div class="card-header">
          <span class="card-num">{String(index + 1).padStart(2, '0')}</span>
          <div class="card-header-end">
            {project.role && <span class="card-role">{project.role}</span>}
            <span class="card-arrow" aria-hidden="true">↗</span>
          </div>
        </div>
        <div class="card-body">
          <h3 style={`view-transition-name: project-${project.slug}`}>{project.title}</h3>
          <p>{project.outcome || project.summary}</p>
        </div>
        <ul class="card-tags" aria-label="Technologies">
          {project.tech.slice(0, 4).map((item) => <li>{item}</li>)}
        </ul>
      </a>
    </article>
  ))}
</div>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .project-card {
    border: 1px solid var(--line-inner);
    background: var(--paper-raised);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .project-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05);
  }

  :global(html.theme-dark) .project-card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
    text-decoration: none;
    color: inherit;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px dashed var(--line-inner);
    font-family: var(--mono);
    font-size: var(--type-label);
    color: var(--muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .card-num {
    font-weight: 500;
  }

  .card-header-end {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
    overflow: hidden;
  }

  .card-role {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 0.85;
  }

  .card-arrow {
    display: inline-block;
    transition: transform 180ms ease, color 180ms ease;
    font-size: 1.1em;
  }

  .project-card:hover .card-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .card-body {
    flex-grow: 1;
    margin-bottom: 1.5rem;
  }

  .card-body h3 {
    margin: 0 0 0.6rem;
    font-family: var(--display);
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0.01em;
    transition: color 160ms ease;
  }

  .project-card:hover .card-body h3 {
    color: var(--accent);
  }

  .card-body p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card-tags li {
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--line-inner);
    border-radius: 2px;
    background: color-mix(in srgb, var(--ink) 3%, transparent);
    color: var(--muted);
    font-family: var(--mono);
    font-size: var(--type-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: border-color 160ms ease, color 160ms ease;
  }

  .project-card:hover .card-tags li {
    border-color: color-mix(in srgb, var(--accent) 30%, var(--line));
  }

  @supports (animation-timeline: view()) {
    .project-card {
      animation: card-in linear both;
      animation-range: entry 0 entry 80%;
      animation-timeline: view();
    }
  }

  @keyframes card-in {
    from {
      opacity: 0.4;
      transform: translateY(1.2rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .project-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      animation: none;
      transition: none;
    }

    .project-card:hover {
      transform: none;
    }

    .project-card:hover .card-arrow {
      transform: none;
    }
  }
</style>
