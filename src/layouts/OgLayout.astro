---
import '../styles/global.css';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1200" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <header>
        <span class="mark"></span>
        <span>Uday Girhepunje</span>
        <span class="label">{eyebrow}</span>
      </header>
      <div>
        <h1>{title}</h1>
        <p>{description}</p>
      </div>
      <footer>udaygirhepunje.github.io</footer>
    </main>
  </body>
</html>

<style>
  :global(html),
  :global(body) {
    width: 1200px;
    height: 630px;
    overflow: hidden;
    background: var(--paper);
  }

  main {
    display: grid;
    width: 100%;
    height: 100%;
    grid-template-rows: auto 1fr auto;
    padding: 50px 64px;
  }

  header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--line);
    font-family: var(--serif);
    font-size: 25px;
  }

  .mark {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--accent);
  }

  .label {
    margin-left: auto;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  main > div {
    align-self: center;
  }

  h1 {
    max-width: 1000px;
    margin: 0 0 32px;
    color: var(--accent);
    font-size: 112px;
    line-height: 0.9;
  }

  p {
    max-width: 800px;
    margin: 0;
    color: var(--muted);
    font-size: 26px;
    line-height: 1.4;
  }

  footer {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
</style>
