---
import '../../styles/global.css';
import { getResume } from '../../lib/data';

const resume = await getResume();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Uday Girhepunje résumé</title>
  </head>
  <body>
    <main>
      <header>
        <div>
          <h1>{resume.name}</h1>
          <p class="role">{resume.title}</p>
        </div>
        <address>
          {resume.location}<br />
          <a href={`mailto:${resume.contact.email}`}>{resume.contact.email}</a><br />
          <span data-pdf-phone></span>
          <a href={resume.contact.github}>github.com/udaygirhepunje</a><br />
          <a href={resume.contact.linkedin}>linkedin.com/in/uday-girhepunje</a>
        </address>
      </header>
      <p class="summary">{resume.summary}</p>

      <section>
        <h2>Skills</h2>
        {resume.skills.map((group) => (
          <p class="skill"><strong>{group.category}</strong> {group.items.join(' · ')}</p>
        ))}
      </section>

      <section>
        <h2>Professional experience</h2>
        {resume.experience.map((job) => (
          <article>
            <div class="row">
              <h3>{job.role} · {job.company}</h3>
              <span>{job.start} – {job.end}</span>
            </div>
            <ul>{job.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
          </article>
        ))}
      </section>

      <section>
        <h2>Education</h2>
        {resume.education.map((item) => (
          <div class="row">
            <div>
              <h3>{item.degree}</h3>
              <p>{item.institution}</p>
            </div>
            <span>{item.start} – {item.end}</span>
          </div>
        ))}
      </section>

      <section>
        <h2>Achievements</h2>
        <ul>{resume.achievements.map((achievement) => <li>{achievement}</li>)}</ul>
      </section>
    </main>
  </body>
</html>

<style>
  @page {
    size: A4;
    margin: 12mm 14mm;
  }

  body {
    background: #fff;
    color: #111;
    font-family: Arial, sans-serif;
    font-size: 9.2pt;
    line-height: 1.35;
  }

  main {
    width: auto;
    margin: 0;
  }

  header,
  .row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  h1 {
    margin: 0;
    font-size: 28pt;
  }

  .role {
    margin: 0.2rem 0 0;
    font-weight: 700;
  }

  address {
    font-style: normal;
    text-align: right;
  }

  .summary {
    margin: 1rem 0;
  }

  section {
    margin-top: 0.85rem;
  }

  h2 {
    margin: 0 0 0.35rem;
    padding-bottom: 0.15rem;
    border-bottom: 1px solid #555;
    font-family: Arial, sans-serif;
    font-size: 11pt;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    font-family: Arial, sans-serif;
    font-size: 9.6pt;
    font-weight: 700;
    line-height: 1.3;
  }

  article {
    break-inside: avoid;
    margin-bottom: 0.7rem;
  }

  article ul,
  section > ul {
    margin: 0.3rem 0 0;
    padding-left: 1.2rem;
  }

  li {
    margin-bottom: 0.18rem;
  }

  .skill {
    margin: 0 0 0.2rem;
  }

  .row p {
    margin: 0.1rem 0 0;
  }

  [data-pdf-phone]:not(:empty)::after {
    content: '\A';
    white-space: pre;
  }
</style>
