---
import HeroGraphic from '../components/HeroGraphic.astro';
import JournalList from '../components/JournalList.astro';
import ProjectList from '../components/ProjectList.astro';
import StatsGrid from '../components/StatsGrid.astro';
import YearReview from '../components/YearReview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGithubStats, getJournal, getProfile, getProjects, getResume } from '../lib/data';

const [profile, resume, projects, journal] = await Promise.all([
  getProfile(),
  getResume(),
  getProjects(),
  getJournal(),
]);
const github = getGithubStats();
const hasAllStats = [
  github.totalContributions,
  github.publicRepoCount,
  github.pullRequestContributions,
  github.accountYears,
].every((value) => value !== null);
const stats = hasAllStats
  ? [
      { value: Number(github.totalContributions).toLocaleString(), label: 'Contributions · 12 months' },
      { value: Number(github.publicRepoCount), label: 'Public repositories' },
      { value: Number(github.pullRequestContributions).toLocaleString(), label: 'Pull requests · 12 months' },
      { value: `${Number(github.accountYears)}+`, label: 'Years on GitHub' },
    ]
  : [];
const journalCards = journal.slice(0, 3).map((entry) => ({
  slug: entry.id.replace(/\.(md|mdx)$/, ''),
  title: entry.data.title,
  description: entry.data.description,
  date: entry.data.publishedAt,
  type: entry.data.type,
  cover: entry.data.cover,
  coverAlt: entry.data.coverAlt,
}));
const projectCards = projects.map(({ slug, title, summary, outcome, tech }) => ({
  slug,
  title,
  summary,
  outcome,
  tech,
}));

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.headline,
  url: 'https://udaygirhepunje.github.io',
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: profile.location },
  sameAs: profile.links.map((link) => link.url),
  worksFor: { '@type': 'Organization', name: 'AppDirect' },
};
---

<BaseLayout>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />
  <section class="hero page-shell">
    <div class="hero-copy">
      <p class="eyebrow">Associate SDE · AppDirect · Pune</p>
      <h1 class="display">{profile.name}</h1>
      <p class="lede">{profile.bio}</p>
      {profile.openToWork && <p class="availability"><span></span> Open to full-stack opportunities</p>}
      <div class="actions">
        <a class="button primary" href="/downloads/uday-girhepunje-resume.pdf" download>Download résumé</a>
        <a class="button" href={`mailto:${profile.email}`}>Email me</a>
      </div>
    </div>
    {stats.length > 0 ? <StatsGrid stats={stats} /> : <HeroGraphic />}
  </section>

  <section class="section page-shell" aria-labelledby="work-title">
    <div class="section-heading">
      <p class="eyebrow">Selected work</p>
      <a href="/projects/">All projects</a>
    </div>
    <h2 id="work-title" class="visually-hidden">Selected projects</h2>
    <ProjectList projects={projectCards} limit={6} />
  </section>

  <section class="section page-shell experience" aria-labelledby="experience-title">
    <p class="eyebrow">Experience</p>
    <h2 id="experience-title" class="section-title">Work that moved a number.</h2>
    <div class="experience-list rule-list">
      {resume.experience.slice(0, 2).map((job) => (
        <article class="rule-row">
          <div>
            <h3>{job.role}</h3>
            <p>{job.company}</p>
          </div>
          <p class="mono">{job.start} — {job.end}</p>
          <p>{job.highlights[0]}</p>
        </article>
      ))}
    </div>
    <a class="text-link" href="/about/">Full experience and skills →</a>
  </section>

  {github.weeks.length > 0 && github.totalContributions !== null && github.pullRequestContributions !== null && (
    <YearReview
      weeks={github.weeks}
      commits={github.totalContributions}
      pullRequests={github.pullRequestContributions}
    />
  )}

  {journalCards.length > 0 && (
    <section class="section page-shell" aria-labelledby="journal-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Also</p>
          <h2 id="journal-title" class="section-title">Outside the ticket.</h2>
        </div>
        <a href="/journal/">Open journal</a>
      </div>
      <JournalList entries={journalCards} />
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    display: grid;
    min-height: calc(100vh - 5.25rem);
    grid-template-columns: 1.25fr minmax(22rem, 0.75fr);
    gap: clamp(4rem, 8vw, 8rem);
    align-items: center;
    padding-block: clamp(5rem, 10vw, 9rem);
  }

  .hero h1 {
    margin-bottom: 2.5rem;
    color: var(--accent);
  }

  .availability {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--mono);
    font-size: var(--type-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .availability span {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0.3rem color-mix(in srgb, var(--accent) 15%, transparent);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .section-heading .section-title {
    margin-bottom: 0;
  }

  .section-heading > a,
  .text-link {
    font-family: var(--mono);
    font-size: var(--type-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .experience-list article {
    display: grid;
    grid-template-columns: 1fr 0.45fr 1fr;
    gap: 2rem;
    align-items: start;
    padding-block: 2rem;
  }

  .experience-list h3 {
    margin: 0;
    font-size: var(--type-list);
  }

  .experience-list p {
    margin: 0;
    color: var(--muted);
  }

  .text-link {
    display: inline-block;
    margin-top: 2rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .experience-list article {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }
  }

  @media (max-width: 700px) {
    .section-heading {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
