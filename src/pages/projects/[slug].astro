---
import { render } from 'astro:content';
import ImageLightbox from '../../components/ImageLightbox.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/data';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const rendered = project.entry ? await render(project.entry) : null;
const Content = rendered?.Content;
const hasCustomContent = Boolean(Content && project.entry?.body && project.entry.body.trim().length > 0);
---

<BaseLayout
  title={`${project.title} · Uday Girhepunje`}
  description={project.summary}
  image={`/og/projects/${project.slug}.png`}
>
  <article class="project-page">
    <header class="page-shell project-header">
      <div class="header-top">
        <p class="eyebrow">{project.role}{project.duration ? ` · ${project.duration}` : ''}</p>
        <div class="actions">
          {project.links.map((link) => {
            const isGithub = link.label.toLowerCase() === 'github' || link.url.includes('github.com');
            return (
              <a class="button" href={link.url} target="_blank" rel="noreferrer">
                <span>{link.label}</span>
                {isGithub && typeof project.stars === 'number' && project.stars > 0 && (
                  <span class="btn-stars">★ {project.stars}</span>
                )}
              </a>
            );
          })}
        </div>
      </div>
      <h1 class="page-title" style={`view-transition-name: project-${project.slug}`}>{project.title}</h1>
      <p class="lede summary">{project.summary}</p>
      <div class="project-tech">
        <ul aria-label="Technologies">
          {project.tech.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </header>

    {project.cover && (
      <div class="page-shell project-cover">
        <ImageLightbox src={project.cover} alt={project.coverAlt || `${project.title} project cover`} id={project.slug} />
      </div>
    )}

    {(project.problem || project.outcome || hasCustomContent) && (
      <section class="page-shell section case-study-section">
        {(project.problem || project.outcome) && (
          <div class="case-study-cards">
            {project.problem && (
              <div class="brief-card">
                <span class="card-kicker mono">The Problem</span>
                <p class="card-text">{project.problem}</p>
              </div>
            )}
            {project.outcome && (
              <div class="brief-card outcome-card">
                <span class="card-kicker mono">The Outcome</span>
                <p class="card-text">{project.outcome}</p>
              </div>
            )}
          </div>
        )}

        {hasCustomContent && Content && (
          <div class="project-notes-block">
            <span class="card-kicker mono">Overview & Implementation</span>
            <div class="prose">
              <Content />
            </div>
          </div>
        )}
      </section>
    )}

    {project.readmeHtml && (
      <section class="page-shell section repository-readme">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Documentation</p>
            <h2 class="section-title">README.md</h2>
          </div>
          {project.githubUrl && (
            <a class="button" href={project.githubUrl} target="_blank" rel="noreferrer">
              <span>Repository on GitHub ↗</span>
              {typeof project.stars === 'number' && project.stars > 0 && (
                <span class="btn-stars">★ {project.stars}</span>
              )}
            </a>
          )}
        </div>
        <div class="prose github-readme" set:html={project.readmeHtml} />
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .project-header {
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: clamp(2rem, 3.5vw, 3rem);
  }

  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .header-top .eyebrow {
    margin-bottom: 0;
  }

  .page-title {
    margin-block: 0.5rem 1.25rem;
    color: var(--accent);
  }

  .lede.summary {
    max-width: 52rem;
    margin-bottom: 1.75rem;
  }

  .project-tech ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0;
    padding: 0;
    color: var(--muted);
    font-family: var(--mono);
    font-size: var(--type-label);
    letter-spacing: 0.1em;
    list-style: none;
    text-transform: uppercase;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .btn-stars {
    display: inline-flex;
    align-items: center;
    margin-left: 0.5rem;
    padding-left: 0.5rem;
    border-left: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    font-size: 0.9em;
    opacity: 0.9;
  }

  .case-study-section {
    padding-block: clamp(2.5rem, 4vw, 3.5rem);
  }

  .case-study-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .brief-card {
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border: 1px solid var(--line-inner);
    background: var(--paper-raised);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .brief-card.outcome-card {
    border-left: 3px solid var(--accent);
  }

  .card-kicker {
    font-family: var(--mono);
    font-size: var(--type-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .card-text {
    margin: 0;
    font-family: var(--sans);
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--ink);
    text-wrap: pretty;
  }

  .project-notes-block {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px dashed var(--line-inner);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  :global(.project-notes-block .prose > :first-child) {
    margin-top: 0;
  }

  .project-cover {
    padding-bottom: clamp(2rem, 3.5vw, 3rem);
  }

  .repository-readme {
    padding-block: clamp(2.5rem, 4.5vw, 4rem);
  }

  .repository-readme .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    margin-bottom: clamp(2rem, 3.5vw, 3rem);
  }

  .repository-readme .section-title {
    margin-bottom: 0;
  }

  :global(.github-readme > :first-child) {
    margin-top: 0;
  }

  @media (max-width: 768px) {
    .header-top {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }

    .case-study-cards {
      grid-template-columns: 1fr;
    }

    .repository-readme .section-heading {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
