---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import { getResume } from '../lib/data';

const resume = await getResume();
---

<BaseLayout
  title="About and résumé · Uday Girhepunje"
  description={resume.summary}
  image="/og/about.png"
>
  <section class="page-shell intro">
    <div class="intro-title">
      <p class="eyebrow">About · Pune, India</p>
      <h1 class="page-title">Full stack,<br /><em>measured.</em></h1>
    </div>
    <div class="summary">
      <p class="lede">{resume.summary}</p>
      <a class="button primary" href="/downloads/uday-girhepunje-resume.pdf" download>Download résumé</a>
    </div>
  </section>

  <section class="page-shell section" aria-labelledby="experience">
    <p class="eyebrow">Professional experience</p>
    <h2 id="experience" class="section-title">Engineering roles</h2>
    <ExperienceTimeline items={resume.experience} location={resume.location} showAllHighlights={true} />
  </section>

  <section class="page-shell section resume-grid">
    <div>
      <p class="eyebrow">Skills</p>
      {resume.skills.map((group) => (
        <div class="skill-group">
          <h3>{group.category}</h3>
          <p>{group.items.join(' · ')}</p>
        </div>
      ))}
    </div>
    <div>
      <p class="eyebrow">Education</p>
      {resume.education.map((item) => (
        <div class="education">
          <h3>{item.degree}</h3>
          <p>{item.institution}</p>
          <p class="mono">{item.start} — {item.end}</p>
        </div>
      ))}
      <p class="eyebrow achievements-label">Achievements</p>
      {resume.achievements.map((achievement) => <p>{achievement}</p>)}
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    display: grid;
    min-height: 48vh;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(3rem, 6vw, 6rem);
    align-items: center;
    padding-block: var(--space);
  }

  .intro h1 {
    margin: 0;
    color: var(--accent);
  }

  .intro em {
    color: var(--ink);
    font-weight: 400;
  }

  .summary .lede {
    margin-bottom: 2rem;
  }

  .skill-group h3,
  .education h3 {
    margin-bottom: 0.4rem;
    font-size: var(--type-list);
  }

  .education p {
    margin: 0;
    color: var(--muted);
  }

  .resume-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(4rem, 10vw, 10rem);
  }

  .skill-group,
  .education {
    padding-block: 1.5rem;
    border-bottom: 1px dashed var(--line-inner);
  }

  .skill-group p {
    margin: 0;
    color: var(--muted);
  }

  .achievements-label {
    margin-top: 4rem;
  }

  @media (max-width: 800px) {
    .intro,
    .resume-grid {
      grid-template-columns: 1fr;
    }

    .intro {
      gap: 1rem;
    }

    .summary {
      align-self: start;
    }

    .job header {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
