---
import JournalList from '../../components/JournalList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getJournal } from '../../lib/data';

const journal = await getJournal();
const entries = journal.map((entry) => ({
  slug: entry.id.replace(/\.(md|mdx)$/, ''),
  title: entry.data.title,
  description: entry.data.description,
  date: entry.data.publishedAt,
  type: entry.data.type,
  cover: entry.data.cover,
  coverAlt: entry.data.coverAlt,
}));
---

<BaseLayout
  title="Journal · Uday Girhepunje"
  description="Notes on engineering, photographs, artwork, and things made away from a ticket."
>
  <header class="page-shell page-header">
    <p class="eyebrow">Journal · {entries.length}</p>
    <h1 class="page-title">Outside<br /><em>the ticket.</em></h1>
    <p class="lede">Engineering notes first. Photographs, artwork, and whatever else survives the edit.</p>
  </header>
  <section class="page-shell section">
    {entries.length > 0 ? <JournalList entries={entries} /> : <p class="muted">Nothing published yet.</p>}
  </section>
</BaseLayout>

<style>
  .page-header {
    display: grid;
    min-height: 48vh;
    align-content: center;
    padding-block: var(--space);
  }

  h1 {
    color: var(--accent);
  }

  h1 em {
    color: var(--ink);
    font-weight: 400;
  }
</style>
